{
  "name": "@quellenkontor/sdk",
  "version": "0.1.2",
  "description": "Offizielles SDK für die Quellenkontor-API: geprüfte HR-Daten mit Quelle und Gültigkeit. German HR reference data with source and validity: minimum wage, social security, public holidays.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./offline": {
      "import": {
        "types": "./dist/offline.d.ts",
        "default": "./dist/offline.js"
      },
      "require": {
        "types": "./dist/cjs/offline.d.ts",
        "default": "./dist/cjs/offline.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hr",
    "mindestlohn",
    "sozialversicherung",
    "feiertage",
    "api",
    "mcp",
    "lohn",
    "germany",
    "german",
    "minimum-wage",
    "payroll",
    "social-security",
    "public-holidays",
    "hr-data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicksAdvisory/quellenkontor-sdk.git",
    "directory": "packages/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/NicksAdvisory/quellenkontor-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://quellenkontor.dev/docs/sdk-javascript",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
