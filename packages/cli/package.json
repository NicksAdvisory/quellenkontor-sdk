    "public-holidays",
    "hr-data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicksAdvisory/quellenkontor-sdk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NicksAdvisory/quellenkontor-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://quellenkontor.dev/docs/cli",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@quellenkontor/sdk": "0.1.1"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
